# Google Calendar API (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=calendly-bot@chantalmasse-booking.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=chantal@chantalmasse.com

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=reservations@chantalmasse.com
EMAIL_TO=chantal@chantalmasse.com

# Booking config
BOOKING_TIMEZONE=America/Toronto
BOOKING_ADVANCE_DAYS=60
BOOKING_MIN_NOTICE_HOURS=24

# Admin Access
ADMIN_PASSWORD=changeme123

# Meta Graph API (organic content posting)
META_ACCESS_TOKEN=your_meta_long_lived_token
META_IG_USER_ID=your_instagram_user_id
META_FB_PAGE_ID=your_facebook_page_id

# Meta Conversions API (server-side ad conversion tracking)
# DIFFERENT from META_ACCESS_TOKEN above. Generate at:
#   Events Manager → your Pixel → Settings → Conversions API → Generate access token
# Pixel ID: Events Manager → Data Sources → your Pixel → ID
META_PIXEL_ID=your_meta_pixel_id
META_CAPI_ACCESS_TOKEN=your_meta_capi_access_token
# Optional — set during QA to route events to the "Test Events" tab in
# Events Manager. Leave blank in production.
META_CAPI_TEST_EVENT_CODE=

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Brief delivery
BRIEF_EMAIL=cchantal.gmasse@gmail.com

# Instagram Scraper (Apify)
# Create a free account at apify.com → Settings → Integrations → API token
# Actor used: apify/instagram-profile-scraper (~$0.30/month for weekly scrapes)
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxx
