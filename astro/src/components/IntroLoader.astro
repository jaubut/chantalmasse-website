---
// components/IntroLoader.vue as static markup + an inline script: the overlay runs as soon as it is parsed instead of
// after the Vue runtime loads (it no longer waits on any module). Shown only while <html> has .cm-intro (set pre-paint in
// Base.astro: first visit of the session, no reduced motion). Adapted from BYQ gem liquid-wordmark-fill-preloader-01.
---
<div class="cm-intro-overlay" aria-hidden="true">
  <div class="relative font-headline italic text-5xl sm:text-7xl leading-none whitespace-nowrap">
    <span class="cm-intro-outline block">Chantal Massé</span>
    <span id="cm-intro-fill" class="cm-intro-fill absolute inset-0 block text-secondary">Chantal Massé</span>
  </div>
</div>
<script is:inline>
(() => {
  const html = document.documentElement
  if (!html.classList.contains('cm-intro')) return
  const fill = document.getElementById('cm-intro-fill')
  const FILL_MS = 1400, HOLD_MS = 300, LIFT_MS = 500, POINTS = 16, AMP = 3
  // Late (slow network): don't make the visitor wait for the full fill.
  const fillMs = performance.now() > 1200 ? 0 : FILL_MS
  const start = performance.now()
  let raf = 0
  const render = (now) => {
    const t = now - start
    const progress = Math.min(1, fillMs ? t / fillMs : 1)
    const eased = progress < 0.5 ? 2 * progress * progress : 1 - (-2 * progress + 2) ** 2 / 2
    const base = 100 - eased * 110
    const pts = []
    for (let i = 0; i <= POINTS; i++) pts.push(`${(i / POINTS) * 100}% ${(base + AMP * Math.sin((i / POINTS) * Math.PI * 4 + t / 300)).toFixed(2)}%`)
    if (fill) fill.style.clipPath = `polygon(${pts.join(', ')}, 100% 130%, 0% 130%)`
    if (t < fillMs + HOLD_MS) raf = requestAnimationFrame(render)
  }
  raf = requestAnimationFrame(render)
  setTimeout(() => html.classList.add('cm-intro-out'), fillMs + HOLD_MS)
  setTimeout(() => {
    cancelAnimationFrame(raf)
    html.classList.remove('cm-intro', 'cm-intro-out')
  }, fillMs + HOLD_MS + LIFT_MS)
})()
</script>
