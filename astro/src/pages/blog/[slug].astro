---
// /blog/<slug>: one post, read from the CMS on each request. Same markup as pages/blog/[slug].vue; the body is the
// contract RichText rendered to HTML (src/lib/richtext.ts) inside the same prose wrapper.
import Base from '../../layouts/Base.astro'
import BlogNewsletterForm from '../../vue/components/BlogNewsletterForm.vue'
import BlogPostPage from '../../vue/pages/BlogPostPage.vue'
import { allPosts, getPost, related } from '../../lib/blog'
import { richTextToHtml } from '../../lib/richtext'
import { SITE_URL } from '../../lib/seo'
import { buildPreviewSetCookie } from '../../lib/tls-edit-attrs'

export const prerender = false

const previewToken = Astro.locals.previewToken ?? null
let previewMode = Astro.locals.previewMode ?? Boolean(previewToken)
const isHttps = Astro.url.protocol === 'https:' || Astro.request.headers.get('x-forwarded-proto')?.split(',')[0]?.trim() === 'https'
let cookieCleared = false

const onPreviewRejected = (): void => {
  previewMode = false
  Astro.locals.previewMode = false
  Astro.locals.previewToken = null
  if (!cookieCleared) {
    cookieCleared = true
    Astro.response.headers.append('set-cookie', buildPreviewSetCookie(null, isHttps))
  }
}

const slug = Astro.params.slug ?? ''
const found = await getPost(slug, { previewToken, onPreviewRejected })
if (!found) return Astro.rewrite('/404')
const { post, doc } = found
const rel = related(post, await allPosts({ previewToken: previewMode ? previewToken : null, onPreviewRejected }))
const body = richTextToHtml(doc.body)
const title = `${post.title} — Chantal Massé`
// The hero is the LCP: sized per screen (the engine resizes and picks AVIF/WebP), preloaded from <head>.
const heroSrcset = [640, 960, 1280, 1920].map(w => `${post.imageFull}?w=${w} ${w}w`).join(', ')
const ogImage = post.imageFull.startsWith('/') ? SITE_URL + post.imageFull : post.imageFull
---
<Base
  title={title}
  path={`/blog/${post.slug}`}
  ogType="article"
  ogImage={ogImage}
  emptyDescription
  pageDocId={doc.id}
  locale={doc.locale}
  previewMode={previewMode}
>
  {post.imageFull && <link slot="head" rel="preload" as="image" href={post.image} imagesrcset={heroSrcset} imagesizes="100vw" fetchpriority="high" />}
  <BlogPostPage
    post={post}
    docId={doc.id}
    heroSrcset={heroSrcset}
    bodyHtml={body}
    relatedPosts={rel}
    previewMode={previewMode}
  >
    <BlogNewsletterForm slot="newsletter" client:visible />
  </BlogPostPage>
</Base>
