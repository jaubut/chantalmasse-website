---
// /blog: the listing, read from the CMS on each request (a post published in the portal shows up without a rebuild).
import Base from '../../layouts/Base.astro'
import BlogIndexPage from '../../vue/pages/BlogIndexPage.vue'
import { allPosts, type BlogPost } from '../../lib/blog'
import {
  extractBlogIndexCmsData,
  extractSiteSettings,
  getPage,
  getSettings,
  type CmsSiteSettingsData,
  type PageDoc,
} from '../../lib/cms-client'
import { SKIP_CACHE } from '../../lib/page-cache'
import { HERO_IMAGE } from '../../lib/seo'
import { buildPreviewSetCookie } from '../../lib/tls-edit-attrs'

export const prerender = false

const previewToken = Astro.locals.previewToken ?? null
let previewMode = Astro.locals.previewMode ?? Boolean(previewToken)
const isHttps = Astro.url.protocol === 'https:' || Astro.request.headers.get('x-forwarded-proto')?.split(',')[0]?.trim() === 'https'
let cookieCleared = false

const onPreviewRejected = (): void => {
  previewMode = false
  Astro.locals.previewMode = false
  Astro.locals.previewToken = null
  if (!cookieCleared) {
    cookieCleared = true
    Astro.response.headers.append('set-cookie', buildPreviewSetCookie(null, isHttps))
  }
}

const [postsResult, pageResult, settingsResult] = await Promise.allSettled([
  allPosts({ previewToken, onPreviewRejected }),
  getPage('/blog', { previewToken, onPreviewRejected }),
  getSettings({ previewToken, onPreviewRejected }),
])

let posts: BlogPost[] = []
if (postsResult.status === 'fulfilled') {
  posts = postsResult.value
} else {
  console.error('[blog] posts unavailable', postsResult.reason)
  Astro.response.headers.set(SKIP_CACHE, '1')
}

let page: PageDoc | null = null
if (pageResult.status === 'fulfilled') {
  page = pageResult.value
} else {
  console.error('[blog] page blocks unavailable', pageResult.reason)
  Astro.response.headers.set(SKIP_CACHE, '1')
}

let siteSettings: CmsSiteSettingsData | undefined
if (settingsResult.status === 'fulfilled') {
  siteSettings = extractSiteSettings(settingsResult.value)
} else {
  console.error('[blog] settings unavailable', settingsResult.reason)
  Astro.response.headers.set(SKIP_CACHE, '1')
}

const cmsBlog = extractBlogIndexCmsData(page)
const description = 'Des réflexions sur le mieux-être, les relations et la croissance personnelle.'
---
<Base
  title="Blogue — Chantal Massé"
  path="/blog"
  description={description}
  ogImage={HERO_IMAGE}
  pageDocId={cmsBlog.docId}
  previewMode={previewMode}
  cmsSettings={siteSettings ?? null}
>
  <BlogIndexPage
    client:load
    posts={posts}
    {...(cmsBlog.hero ? { cmsHero: cmsBlog.hero } : {})}
    {...(previewMode ? { previewMode: true } : {})}
  />
</Base>
