---
import Base from '../layouts/Base.astro'
import { HERO_IMAGE } from '../lib/seo'
import { pageDocId, readPreviewCookie } from '../lib/tls-edit-attrs'
import TherapieIndividuellePage from '../vue/pages/TherapieIndividuellePage.vue'

export const prerender = false

const previewToken = Astro.locals.previewToken ?? readPreviewCookie(Astro.request.headers.get('cookie'))
const previewMode = Astro.locals.previewMode ?? Boolean(previewToken)
const docId = pageDocId('therapie-individuelle')
---
<Base
  title="Thérapie individuelle à Shefford | Chantal Massé — Thérapeute en relation d'aide"
  path="/therapie-individuelle"
  description="Thérapie individuelle à Shefford et en vidéoconférence. Approche centrée sur la personne pour explorer vos patterns, apaiser les blessures et retrouver confiance. 60 min — 105$. Reçus RITMA."
  ogTitle="Thérapie individuelle à Shefford | Chantal Massé"
  ogDescription="Un espace sécurisé pour explorer ce qui te fait mal et cheminer vers un mieux-être. Réserve ta séance."
  ogImage={HERO_IMAGE}
  pageDocId={docId}
  previewMode={previewMode}
>
  <TherapieIndividuellePage previewMode={previewMode} />
</Base>
