// Astro build of chantalmasse.com (Cloudflare Worker `chantalmasse-website`).
// Top level and `env.production` both target the single live production Worker `chantalmasse-website`
// so plain `wrangler deploy` and `CLOUDFLARE_ENV=production` builds never recreate a duplicate Worker.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "chantalmasse-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  // nodejs_compat: process.env carries the secrets (server/utils/sms.ts, metaCapi.ts read it).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    // /journey.html is served at /journey; public/_redirects (copied to dist) runs first: /path/ → /path 301.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  // Version id: part of the HTML cache key (src/middleware.ts), so a deploy never serves pages built by the previous one.
  "version_metadata": { "binding": "CF_VERSION" },
  "workers_dev": false,
  "preview_urls": false,
  // Busy times per month + the Google access token (server/utils/bookingCache.ts).
  // PAGE_CACHE: HTML of the CMS-backed pages (src/middleware.ts), same namespace, keys `html:<path>`.
  "kv_namespaces": [
    { "binding": "BOOKING_CACHE", "id": "e71462224c254ab5a42b710bc086ca2a" },
    { "binding": "PAGE_CACHE", "id": "e71462224c254ab5a42b710bc086ca2a" }
  ],
  // Production TLS CMS read API (cms-client): binds `CMS` to the production `tls-cms` Worker (`SiteReads` entrypoint,
  // provisioned with the `chantal-masse` D1 database and R2 media bucket in jaubut/tls-dashboard-v2#498).
  "services": [{ "binding": "CMS", "service": "tls-cms", "entrypoint": "SiteReads" }],
  "vars": {},
  "env": {
    "production": {
      "name": "chantalmasse-website",
      "workers_dev": false,
      "kv_namespaces": [
        { "binding": "BOOKING_CACHE", "id": "e71462224c254ab5a42b710bc086ca2a" },
        { "binding": "PAGE_CACHE", "id": "e71462224c254ab5a42b710bc086ca2a" }
      ],
      // Production TLS CMS read API (cms-client): binds `CMS` to the production `tls-cms` Worker (`SiteReads` entrypoint,
      // provisioned with the `chantal-masse` D1 database and R2 media bucket in jaubut/tls-dashboard-v2#498).
      "services": [{ "binding": "CMS", "service": "tls-cms", "entrypoint": "SiteReads" }],
      "version_metadata": { "binding": "CF_VERSION" },
      "vars": {}
    }
  }
}
