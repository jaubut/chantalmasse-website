{
  "name": "chantalmasse-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build --root astro",
    "dev": "astro dev --root astro",
    "preview": "astro preview --root astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bun run astro:check",
    "test:reminder": "esbuild --bundle --platform=node --format=esm --log-level=warning --alias:@trigger.dev/sdk/v3=./tests/stubs/trigger-sdk.ts --alias:googleapis=./tests/stubs/googleapis.ts --alias:twilio=./tests/stubs/twilio.ts --outfile=.test-out/booking-reminder.mjs tests/booking-reminder.test.ts && node .test-out/booking-reminder.mjs",
    "test:rules": "esbuild --bundle --platform=node --format=esm --log-level=warning --outfile=.test-out/session-rules.mjs tests/session-rules.test.ts && node .test-out/session-rules.mjs",
    "astro:build": "astro build --root astro",
    "test:smoke:astro": "playwright test -c playwright.astro.config.ts",
    "parity": "bun scripts/parity-crawl.ts diff docs/migration-baseline/crawl.json https://chantalmasse.com",
    "astro:check": "astro sync --root astro && astro-check --root astro"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/vue": "7.1.6",
    "@google-analytics/data": "^7.2.1",
    "@tailwindcss/typography": "^0.5.20",
    "@trigger.dev/sdk": "4.7.3",
    "astro": "7.4.13",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "google-ads-api": "^25.1.0",
    "googleapis": "^185.0.0",
    "gsap": "^3.15.0",
    "ofetch": "^1.5.1",
    "posthog-js": "^1.438.7",
    "resend": "^6.32.1",
    "twilio": "^6.1.2",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.13.0",
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/utils": "^3.1.7",
    "@iconify/vue": "^5.0.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "h3": "^1.15.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.165.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "ws": "^8.21.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
