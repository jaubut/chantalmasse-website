# Legacy Wix URLs (old ads, sitelinks, backlinks). Real 301s keep gclid/utm:
# the prerendered meta-refresh stubs for the same routes drop the query string.
# Keep in sync with the redirect routeRules in nuxt.config.ts and the www zone
# rules in docs/url-fixes-deploy-notes.md. Destinations are the final no-slash
# URLs so every redirect is a single hop.
/coaching-relationnel-couple /coaching-de-couple 301
/coaching-relationnel-couple/ /coaching-de-couple 301
/coaching-relationnel-de-couple-chantal /coaching-de-couple 301
/coaching-relationnel-de-couple-chantal/ /coaching-de-couple 301
/therapie-individuelle-chantal /therapie-individuelle 301
/therapie-individuelle-chantal/ /therapie-individuelle 301
/book-online / 301
/book-online/ / 301
/booking-calendar / 301
/booking-calendar/ / 301
/services /prendre-rendez-vous 301
/services/ /prendre-rendez-vous 301

# Multi-slash paths go home first: without this, //evil.com/ would match the catch-all
# below with :splat=/evil.com and 301 to the scheme-relative //evil.com (open redirect).
//* / 301

# No-slash URLs are canonical: /path/ → /path (query kept). Static rules above win first.
/*/ /:splat 301
